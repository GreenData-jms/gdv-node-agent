# EXAMPLE of the scoped sudoers the bootstrap renders to /etc/sudoers.d/gdv-node-agent
# (for the default units hermes:litellm:gdv-node-agent). This is the ENTIRE extent
# of `nodeagent`'s root privilege — specific systemctl verbs on named units and
# journalctl reads on those units. No general root, no shell, no wildcards on the
# command itself. Reviewed as part of the supply chain (ADR-002).
#
# The live file is generated by deploy/bootstrap.sh from GDV_AGENT_SERVICE_UNITS,
# so it always matches the agent's actual unit allowlist. This copy is for review.

Cmnd_Alias GDV_SYSTEMCTL = \
    /usr/bin/systemctl start hermes, \
    /usr/bin/systemctl stop hermes, \
    /usr/bin/systemctl restart hermes, \
    /usr/bin/systemctl status hermes, \
    /usr/bin/systemctl is-active hermes, \
    /usr/bin/systemctl start litellm, \
    /usr/bin/systemctl stop litellm, \
    /usr/bin/systemctl restart litellm, \
    /usr/bin/systemctl status litellm, \
    /usr/bin/systemctl is-active litellm, \
    /usr/bin/systemctl start gdv-node-agent, \
    /usr/bin/systemctl stop gdv-node-agent, \
    /usr/bin/systemctl restart gdv-node-agent, \
    /usr/bin/systemctl status gdv-node-agent, \
    /usr/bin/systemctl is-active gdv-node-agent

Cmnd_Alias GDV_JOURNAL = \
    /usr/bin/journalctl -u hermes *, \
    /usr/bin/journalctl -u litellm *, \
    /usr/bin/journalctl -u gdv-node-agent *

nodeagent ALL=(root) NOPASSWD: GDV_SYSTEMCTL, GDV_JOURNAL
